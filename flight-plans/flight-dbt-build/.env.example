# Reference config for flight-dbt-build.
#
# Local run:  copy to .env, fill in MOTHERDUCK_TOKEN, then
#   export $(grep -v '^#' .env | xargs) && uv run --with-requirements requirements.txt flight.py
# Deploy:     the same keys (minus the token) become the Flight `config` MAP in
#   MD_CREATE_FLIGHT(..., config := MAP { 'GIT_REPO': '...', ... }).
# Every value below is the default baked into read_config() in flight.py.

# --- Auth ---
# Required. Injected automatically when deployed as a Flight; set it yourself for local runs.
MOTHERDUCK_TOKEN=your_token_here
# Optional. Only for a PRIVATE dbt repo. Deployed, store it in a TYPE flights secret instead of here.
# GIT_TOKEN=github_pat_...

# --- Where the dbt project lives ---
GIT_REPO=https://github.com/motherduckdb/motherduck-cookbook.git
GIT_REF=main                       # branch, tag, or commit SHA (pin for reproducible runs)
REPO_SUBDIR=dbt-churn-prediction   # path within the repo to the dbt project

# --- How to run ---
RUN_MODE=build                     # build = dbt seed + dbt build; test = dbt test only
DBT_TARGET=prod                    # target in the project's profiles.yml (dbt --target)
DB_ENV_VAR=MOTHERDUCK_DATABASE     # env var the project's profile reads its database from
MODELS_DATABASE=dbt_churn_flight   # database the models build into (created if missing)
SELECT=                            # optional dbt node selection (e.g. tag:nightly); empty = whole project

# --- Where the run_results snapshot lands ---
SNAPSHOT_DATABASE=dbt_churn_flight # database holding the run_results history (created if missing)
SNAPSHOT_TABLE=dbt_run_results     # append-only table: one row per dbt node per run
