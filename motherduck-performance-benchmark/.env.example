# Copy this file to .env and fill in both tokens. Never paste tokens into a chat.
# Create tokens in MotherDuck: Settings > Access Tokens.

# Token type "Read Scaling". The benchmark queries run with this token.
MOTHERDUCK_READ_SCALING_TOKEN=

# Token type "Read/Write", from an organization Admin in the same organization.
# Used to read md_information_schema.query_history, save results, and create the Dive.
MOTHERDUCK_TOKEN=
