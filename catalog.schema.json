{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/motherduckdb/motherduck-cookbook/main/catalog.schema.json",
  "title": "MotherDuck Examples Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "generated_at",
    "source",
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "ref"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalog_item"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "catalog_item": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "type",
        "title",
        "description",
        "prompt",
        "category",
        "features",
        "tags",
        "published_date",
        "featured",
        "path",
        "urls",
        "files"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "example",
            "template"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "getting-started",
            "ingestion",
            "analytics",
            "integrations",
            "end-to-end",
            "automation",
            "observability"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "enum": [
              "admin_api",
              "dives",
              "ducklake",
              "flights",
              "mcp",
              "pg_duckdb",
              "pg_endpoint",
              "shares",
              "wasm"
            ]
          },
          "uniqueItems": true
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slug"
          },
          "uniqueItems": true
        },
        "published_date": {
          "type": "string",
          "format": "date"
        },
        "featured": {
          "type": "boolean"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "urls": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "github",
            "raw_docs"
          ],
          "properties": {
            "github": {
              "type": "string",
              "format": "uri"
            },
            "raw_docs": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "files": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/catalog_file"
          }
        },
        "refs": {
          "type": "array",
          "description": "Refs the README declares in front matter. Absent when it declares none.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/catalog_ref"
          }
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "http_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "catalog_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "database"],
          "anyOf": [{ "required": ["docs"] }, { "required": ["url"] }],
          "properties": {
            "kind": { "const": "dataset" },
            "database": { "$ref": "#/$defs/text" },
            "tables": { "type": "array", "items": { "$ref": "#/$defs/text" } },
            "attach": { "$ref": "#/$defs/text" },
            "title": { "$ref": "#/$defs/text" },
            "docs": { "$ref": "#/$defs/text" },
            "url": { "$ref": "#/$defs/http_url" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "doc" },
            "path": { "$ref": "#/$defs/text" },
            "title": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url"],
          "properties": {
            "kind": { "const": "url" },
            "url": { "$ref": "#/$defs/http_url" },
            "title": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["skill", "recipe"] },
            "id": { "$ref": "#/$defs/slug" }
          }
        }
      ]
    },
    "catalog_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "bytes"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
